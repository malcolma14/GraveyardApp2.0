# Mailchimp Marketing API — set these as environment variables in the Vercel
# project (Production + Preview). The /api/subscribe function reads them at
# runtime; they are never exposed to the browser. Copy to .env for local
# `vercel dev` testing (do NOT commit .env).
#
#   MAILCHIMP_API_KEY        Mailchimp > Account & billing > Extras > API keys
#   MAILCHIMP_LIST_ID        Mailchimp > Audience > Settings > Audience name and defaults > Audience ID
#   MAILCHIMP_SERVER_PREFIX  the data centre in your API key / account URL, e.g. "us21"

MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=
